# Copy to .env locally. Never commit real keys.

# Runtime
PORT=4173
DEALGUARD_LIVE_MODE=false

# Oriane: public REST contract currently points to contents search; confirm auth and URL mapping.
ORIANE_API_KEY=
ORIANE_API_BASE_URL=https://connect.oriane.xyz
ORIANE_ANALYZE_PATH=/rest/contents/search
ORIANE_TIMEOUT_MS=20000

# GMI Cloud Inference API (OpenAI-compatible).
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=deepseek-ai/DeepSeek-V4
GMI_TIMEOUT_MS=30000

# Compound: keep unset until the event team provides an API/webhook or approved handoff.
COMPOUND_API_KEY=
COMPOUND_API_BASE_URL=
COMPOUND_RENDER_PATH=/v1/video-concepts
COMPOUND_TIMEOUT_MS=30000

# Optional: if a future Lovable connector/backend is used.
LOVABLE_API_KEY=
LOVABLE_PROJECT_ID=
